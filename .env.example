# Copy this file to .env and fill in what you need. .env is git-ignored: never commit real keys.

# --- LLM -------------------------------------------------------------------------
# auto  = Gemini if GEMINI_API_KEY is set, else Groq if GROQ_API_KEY is set,
#         else the deterministic grounded fallback (no key needed)
# none  = always use the deterministic fallback
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Retrieval (defaults are calibrated; change only if you know why) -------------
# TIER1_MIN_SCORE=0.84
# TIER2_MIN_SCORE=0.84
# RAG_CACHE_TTL_SECONDS=600

# --- Storage (defaults to ./data/...) --------------------------------------------
# DATABASE_PATH=./data/rehlaguide.db
# QDRANT_PATH=./data/qdrant_db
